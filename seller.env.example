# Environment for seller.js when run by seller_watchdog.sh, which sources this
# file before every start. Copy to seller.env (gitignored), fill in, and
# restrict it -- it holds the key to the seller's funds:
#     cp seller.env.example seller.env && chmod 600 seller.env
# Plain KEY=VALUE lines, no spaces around '='.

SELLER_PRIV_KEY=
EVR_PER_BTC=
# required only when asset_name is set in seller.config:
#ASSET_PER_BTC=
