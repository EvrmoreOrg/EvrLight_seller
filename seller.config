
# Plain KEY=VALUE settings, one per line. Comment lines start with #.

# seller.js reads seller.config by default -- You can specify a different config file on the command line, e.g: node seller.js other.config

# SELLER_PRIV_KEY
    # Required environment variable; the key to the address holding the assets and/or EVR being sold.
# EVR_PER_BTC
    # Required environment variable; the relative price of EVR.
# ASSET_PER_BTC
    # Environment variable; the relative price of the asset. Required only when asset_name below is set.

network=testnet
	# "mainnet" or "testnet" -- this, not a separate file, is what picks the network seller.js runs against

min_amount=10
	# EVR (not EVR-sats) -- smallest amount a buyer can request per swap

max_amount=200
	# EVR (not EVR-sats) -- largest amount a buyer can request per swap

asset_name=SWAPASSET
	# Evrmore asset name this seller swaps, or blank for ordinary EVR-mode. Setting this REPLACES
	# EVR-mode entirely for this seller -- min_amount/max_amount above and EVR_PER_BTC stop being used
	# to price the deal itself once this is set (EVR_PER_BTC is still required even in asset-mode, see
	# below); asset_min_amount/asset_max_amount/ASSET_PER_BTC take over instead. Must only use
	# Evrmore's own allowed asset-name characters (A-Z a-z 0-9 @ $ % & * ( ) [ ] { } _ . ? : - # !) --
	# checked at startup, seller.js refuses to start otherwise.

asset_min_amount=2
asset_max_amount=40
	# human-readable asset-quantity bounds (may be fractional, same convention as min_amount/max_amount
	# above -- Evrmore assets use the identical fixed x1e8 on-chain scaling as EVR itself, confirmed
	# against a real testnet asset's own UTXO; only the number of legal decimal places varies per-asset,
	# via that asset's own "units" setting, which this seller does not currently look up). Bounded to
	# Evrmore's own hard whole-unit range, 1 to 21,000,000,000, mirroring EVR's own total-supply scale.
	# Only read when asset_name is set above.

asset_evr_bundle_amount=2
	# EVR (whole units) bundled into every asset-mode HTLC's second, plain output alongside the
	# asset-tagged one -- this is NOT the deal size, it exists only so the buyer's sweep transaction
	# (which spends both HTLC outputs together) has something to pay its own on-chain mining fee out
	# of; the buyer receives back whatever's left after that fee, effectively a small EVR "gas" gift on
	# top of the asset they bought. This EVR physically ends up with the buyer -- but its value is
	# folded into what the buyer is charged over Lightning (via EVR_PER_BTC below), so it is NOT an
	# uncompensated cost to you; only needs to be sized to comfortably cover the buyer's own eventual
	# sweep-tx mining fee, with margin for fee-rate spikes. Required, no safe default, when asset_name
	# is set above.

invoicemac=/home/ubuntu/.lnd-testnet/data/chain/bitcoin/testnet/invoice.macaroon
	# LND invoice macaroon, hex string or file path -- used only for the Lightning side (creating/settling
	# the seller's own hold invoice). Unlike swapservice.config's own macaroon field (permitmac), seller.js
	# never sends a payment -- it only ever receives one and settles/cancels its own invoice -- so LND's
	# stock invoice.macaroon genuinely is enough here; this field's name is accurate as-is.

lndendpoint=https://127.0.0.1:8081
	# LND's REST API endpoint, e.g. https://127.0.0.1:8080 or https://cloud-59.voltage.com

max_aggregate_exposure_evr=2000
	# EVR (not EVR-sats) -- total in-flight capital (summed across every currently "leased" or "signed"
	# lease across all paired swapservices combined), including both the bundled EVR and the EVR-equivalent 
    # value of the assets when in asset mode, this seller will allow before refusing new leases --
	# leave blank to disable the cap

seller_id_key=random
	# random | <nostr_nsec_or_64-char-hex> | blank (blank prompts interactively at startup)

lease_state_file=seller-lease-state.json
	# path to the file seller.js persists its open-lease bookkeeping and refund-key counter to, so a restart
	# (crash, deploy, reboot) can resume watching any lease that was already signed instead of losing track of
	# it. Holds no private key material -- only non-secret metadata (addresses, amounts, a counter) -- but
	# still worth restricting to owner-only read/write (chmod 600) as routine hygiene. If this container/host
	# has a persistent volume, point this at a path on it; if the container is ephemeral, the fallback is
	# seller/recover-refund-key.js (needs only SELLER_PRIV_KEY and a refund_pubkey pulled from relay history or
	# past logs -- see that script's own comments).


# Do not change:
relay=wss://nostr4evr.evrmorecoin.org
swapservice_keys=
max_paired_swapservices=
allow_ephemeral_swapservice=yes
heartbeat_file=seller-heartbeat.json

